<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron job to process Orange Money margin payouts -->
        <record id="ir_cron_orange_money_margin_payouts" model="ir.cron">
            <field name="name">Orange Money: Process Margin Payouts</field>
            <field name="model_id" ref="payment.model_payment_transaction"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_orange_money_margin_payouts()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron job to cleanup old Orange Money data (runs monthly) -->
        <record id="ir_cron_orange_money_cleanup" model="ir.cron">
            <field name="name">Orange Money: Cleanup Old Data</field>
            <field name="model_id" ref="payment.model_payment_transaction"/>
            <field name="state">code</field>
            <field name="code">model._cron_cleanup_old_orange_money_data()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
