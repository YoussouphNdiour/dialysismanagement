                            </div>

                            <div class="col-lg-6 col-md-12 col-sm-12">
                                <div class="hms-graph-card">
                                    <div class="hms-graph-chart-header" t-att-style="'background-color: ' + state.biologieChartColor + '; opacity: 0.9;'">
                                        <span class="hms-chart-header-text">LDL</span>
                                    </div>
                                    <div class="hms-graph-chart-body">
                                        <div t-ref="acsLDLChartContainer" id='acsLDLChartContainer' style="width: 100%; height: 300px;padding:10px"></div>
                                    </div>
                                </div>
                            </div>

                            <!-- Bilan Hépatique -->
                            <div class="col-12"><h4 class="mt-4 mb-3 text-primary">Bilan Hépatique</h4></div>

                            <div class="col-lg-6 col-md-12 col-sm-12">
                                <div class="hms-graph-card">
                                    <div class="hms-graph-chart-header" t-att-style="'background-color: ' + state.biologieChartColor + '; opacity: 0.9;'">
                                        <span class="hms-chart-header-text">ALAT</span>
                                    </div>
                                    <div class="hms-graph-chart-body">
                                        <div t-ref="acsALATChartContainer" id='acsALATChartContainer' style="width: 100%; height: 300px;padding:10px"></div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-6 col-md-12 col-sm-12">
                                <div class="hms-graph-card">
                                    <div class="hms-graph-chart-header" t-att-style="'background-color: ' + state.biologieChartColor + '; opacity: 0.9;'">
                                        <span class="hms-chart-header-text">ASAT</span>
                                    </div>
                                    <div class="hms-graph-chart-body">
                                        <div t-ref="acsASATChartContainer" id='acsASATChartContainer' style="width: 100%; height: 300px;padding:10px"></div>
                                    </div>
                                </div>
                            </div>

                            <!-- Minéraux et Vitamines -->
                            <div class="col-12"><h4 class="mt-4 mb-3 text-primary">Minéraux et Vitamines</h4></div>

                            <div class="col-lg-6 col-md-12 col-sm-12">
                                <div class="hms-graph-card">
                                    <div class="hms-graph-chart-header" t-att-style="'background-color: ' + state.biologieChartColor + '; opacity: 0.9;'">
                                        <span class="hms-chart-header-text">Calcium</span>
                                    </div>
                                    <div class="hms-graph-chart-body">
                                        <div t-ref="acsCalciumChartContainer" id='acsCalciumChartContainer' style="width: 100%; height: 300px;padding:10px"></div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-6 col-md-12 col-sm-12">
                                <div class="hms-graph-card">
                                    <div class="hms-graph-chart-header" t-att-style="'background-color: ' + state.biologieChartColor + '; opacity: 0.9;'">
                                        <span class="hms-chart-header-text">PTHi</span>
                                    </div>
                                    <div class="hms-graph-chart-body">
                                        <div t-ref="acsPTHiChartContainer" id='acsPTHiChartContainer' style="width: 100%; height: 300px;padding:10px"></div>
