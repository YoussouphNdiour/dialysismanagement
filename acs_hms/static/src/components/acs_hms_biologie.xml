                                        <span class="hms-chart-header-text">Créatinine</span>
                                    </div>
                                    <div class="hms-graph-chart-body">
                                        <div t-ref="acsCreatChartContainer" id='acsCreatChartContainer' style="width: 100%; height: 300px;padding:10px"></div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-6 col-md-12 col-sm-12">
                                <div class="hms-graph-card">
                                    <div class="hms-graph-chart-header" t-att-style="'background-color: ' + state.biologieChartColor + '; opacity: 0.9;'">
                                        <span class="hms-chart-header-text">DFG (MDRD)</span>
                                    </div>
                                    <div class="hms-graph-chart-body">
                                        <div t-ref="acsDFGChartContainer" id='acsDFGChartContainer' style="width: 100%; height: 300px;padding:10px"></div>
                                    </div>
                                </div>
                            </div>

                            <!-- Électrolytes -->
                            <div class="col-12"><h4 class="mt-4 mb-3 text-primary">Électrolytes</h4></div>

                            <div class="col-lg-6 col-md-12 col-sm-12">
                                <div class="hms-graph-card">
                                    <div class="hms-graph-chart-header" t-att-style="'background-color: ' + state.biologieChartColor + '; opacity: 0.9;'">
                                        <span class="hms-chart-header-text">Sodium</span>
