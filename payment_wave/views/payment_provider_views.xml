<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">payment.provider.form.wave</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='provider_credentials']" position="after">
                <group name="wave_credentials" invisible="code != 'wave'">
                    <group>
                        <field name="wave_api_key" password="True" placeholder="wave_sn_prod_..."/>
                    </group>
                    <group>
                        <field name="wave_webhook_secret" password="True" placeholder="wave_sn_WHS_..."/>
                        <field name="wave_webhook_strategy"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="payment_provider_view_kanban_wave" model="ir.ui.view">
        <field name="name">payment.provider.kanban.wave</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//templates" position="inside">
                <t t-name="kanban-box" t-if="record.code.raw_value == 'wave'">
                    <div class="oe_kanban_card oe_kanban_global_click">
                        <div class="o_payment_provider_kanban_card">
                            <div class="o_kanban_image">
                                <img type="kanban_image" class="o_image_64_contain" alt="Wave"
                                     t-att-src="_s + '/payment_wave/static/description/icon.png'"/>
                            </div>
                            <div class="o_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="o_kanban_tags_section">
                                    <field name="state" widget="label_selection"
                                           options="{'classes': {'disabled': 'default', 'enabled': 'success', 'test': 'warning'}}"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="company_id" groups="base.group_multi_company"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </xpath>
        </field>
    </record>

</odoo>
