<?xml version="1.0"?>
<odoo>

    <!-- Patient -->
    <record id="view_patient_form" model="ir.ui.view">
        <field name="name">patient.form</field>
        <field name="model">hms.patient</field>
        <field name="inherit_id" ref="acs_hms.view_patient_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='blood_group']" position="after">
                <field name="nephrology_care"/>
                <field name="debugging_treatment_start_date" invisible="not nephrology_care"/>
            </xpath>

            <page name='diseases' position="after">
                <page name='nephrology_history' string="Nephropathie Initiale" invisible="not nephrology_care">
                    <group>
                        <group>
                            <field name="nephro_main_complaint" placeholder="Plainte Principale"/>
                        </group>
                    </group>

                    <separator string="Histoire de la maladie" colspan="4"/>
                    <group>
                        <field name="nephro_disease_history" nolabel="1" placeholder="Histoire de la maladie"/>
                    </group>

                    <separator string="Antecedants personnels" colspan="4"/>
                    <group>
                        <group>
                            <label for="nephro_medical_antecedent" string="Médicaux"/>
                            <field name="nephro_medical_antecedent" nolabel="1" placeholder="Maladie"/>
                            <field name="nephro_surgical_antecedent_ids" widget="many2many_tags" options="{'no_open': True, 'no_create_edit': False}"/>
                        </group>
                        <group string="GO (Gynéco-Obstétrique)">
                            <field name="nephro_menarche_date"/>
                            <field name="nephro_ddr_date"/>
                            <field name="nephro_grossesse"/>
                            <field name="nephro_parite"/>
                            <field name="nephro_avortement"/>
                            <field name="nephro_deces"/>
                        </group>
                    </group>
                    <group>
                        <field name="nephro_lifestyle_ids" widget="many2many_tags"/>
                    </group>

                    <!-- <separator string="Antecedants Familiaux (Ascendants, Descendants, Collatéraux)" colspan="4"/>
                    <group string="Ascendants" >
                        <field name="nephro_family_ascendant_ids" nolabel="1" colspan="4">
                            <list editable="bottom">
                                <field name="relation_type_id" options="{'no_open': True, 'no_create_edit': False}"/>
                                <field name="disease_id"/>
                                <field name="notes"/>
                            </list>
                        </field>
                    </group>
                    <group string="Collatéraux">
                        <field name="nephro_family_collateral_ids" nolabel="1" colspan="4">
                            <list editable="bottom">
                                <field name="relation_type_id" options="{'no_open': True, 'no_create_edit': False}"/>
                                <field name="disease_id"/>
                                <field name="notes"/>
                            </list>
                        </field>
                    </group>
                    <group string="Descendants">
                        <field name="nephro_family_descendant_ids" nolabel="1" colspan="4">
                            <list editable="bottom">
                                <field name="relation_type_id" options="{'no_open': True, 'no_create_edit': False}"/>
                                <field name="disease_id"/>
                                <field name="notes"/>
                            </list>
                        </field>
                    </group> -->

                    <separator string="Informations sociales" colspan="4"/>
                    <group>
                        <group>
                            <field name="nombre_enfants"/>
                            <field name="couverture_sociale"/>
                            <field name="couverture_sociale_detail" invisible="couverture_sociale not in ('assurance', 'mutuelle', 'autre')"/>
                        </group>
                        <group>
                            <field name="mode_dialyse"/>
                            <field name="diurese_residuelle"/>
                            <field name="nb_seances_semaine"/>
                        </group>
                    </group>

                    <separator string="Anthropométrie" colspan="4"/>
                    <group>
                        <group>
                            <field name="taille_patient"/>
                        </group>
                        <group>
                            <field name="bsc"/>
                            <field name="imc_patient"/>
                        </group>
                    </group>

                    <separator string="Néphropathie initiale" colspan="4"/>
                    <group>
                        <group>
                            <field name="nephro_dialysis_start_date"/>
                            <field name="nephro_dialysis_start_center"/>
                            <field name="nephro_tunneled_catheter_date"/>
                        </group>
                        <group>
                            <field name="nephro_catheter_count_simple"/>
                            <field name="nephro_catheter_count_tunneled"/>
                            <field name="nephro_fav_creation_date"/>
                            <field name="nephro_fav_location_id" options="{'no_open': True, 'no_create_edit': False}"/>
                        </group>
                    </group>
                </page>
                <page name='nephrology_imaging' string="Imagerie" invisible="not nephrology_care">
                    <notebook>
                        <page string="Échographies" name="echography">
                            <field name="echography_ids" nolabel="1" context="{'default_patient_id': id}">
                                <list string="Échographies">
                                    <field name="name"/>
                                    <field name="exam_date"/>
                                    <field name="organ"/>
                                    <field name="echo_type"/>
                                    <field name="has_anomalies" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>

                        <page string="Radiographies" name="radio">
                            <field name="radio_ids" nolabel="1" context="{'default_patient_id': id}">
                                <list string="Radiographies">
                                    <field name="name"/>
                                    <field name="exam_date"/>
                                    <field name="anatomic_region"/>
                                    <field name="incidence"/>
                                    <field name="image_quality"/>
                                </list>
                            </field>
                        </page>

                        <page string="TDM" name="tdm">
                            <field name="tdm_ids" nolabel="1" context="{'default_patient_id': id}">
                                <list string="TDM">
                                    <field name="name"/>
                                    <field name="exam_date"/>
                                    <field name="explored_zone"/>
                                    <field name="contrast_used" widget="boolean_toggle"/>
                                    <field name="ctdi"/>
                                    <field name="dlp"/>
                                </list>
                            </field>
                        </page>

                        <page string="IRM" name="irm">
                            <field name="irm_ids" nolabel="1" context="{'default_patient_id': id}">
                                <list string="IRM">
                                    <field name="name"/>
                                    <field name="exam_date"/>
                                    <field name="explored_zone"/>
                                    <field name="contrast_used" widget="boolean_toggle"/>
                                    <field name="exam_duration"/>
                                    <field name="patient_tolerance"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </page>
                <page name='nephrology_cardio' string="Bilan Cardiovasculaire" invisible="not nephrology_care">
                    <notebook>
                        <page string="ECG" name="ecg">
                            <field name="ecg_ids" nolabel="1" context="{'default_patient_id': id}">
                                <list string="ECG">
                                    <field name="name"/>
                                    <field name="exam_date"/>
                                    <field name="rythme"/>
                                    <field name="frequence_cardiaque"/>
                                    <field name="has_anomalies" widget="boolean_toggle"/>
                                    <field name="physician_id"/>
                                </list>
                            </field>
                        </page>

                        <page string="ETT" name="ett">
                            <field name="ett_ids" nolabel="1" context="{'default_patient_id': id}">
                                <list string="ETT">
                                    <field name="name"/>
                                    <field name="exam_date"/>
                                    <field name="fevg"/>
                                    <field name="fevg_status" widget="badge"
                                           decoration-success="fevg_status == 'normale'"
                                           decoration-warning="fevg_status == 'alteree'"
                                           decoration-danger="fevg_status == 'severement_alteree'"/>
                                    <field name="hvg" widget="boolean_toggle"/>
                                    <field name="physician_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </page>
            </page>
        </field>
    </record>

    <record id="action_acs_hms_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">hms.patient</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'default_nephrology_care': True}</field>
        <field name="domain">[('nephrology_care','=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun enregistrement trouvé
            </p>
            <p>
                Cliquez pour ajouter un patient.
            </p>
        </field>
    </record>

    <!-- Appointment View -->
    <record id="action_appointment" model="ir.actions.act_window">
        <field name="name">Rendez-vous</field>
        <field name="res_model">hms.appointment</field>
        <field name="view_mode">list,form,kanban,calendar,pivot</field>
        <field name="domain" eval="[('department_id.department_type','=','nephrology')]"/>
        <field name="context">{'search_default_today': 1,'search_default_done': 1,'acs_department_type': 'nephrology'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun enregistrement trouvé
            </p>
            <p>
                Cliquez pour ajouter un rendez-vous de néphrologie.
            </p>
        </field>
    </record>

    <!-- Treatment -->
    <record id="action_acs_treatment" model="ir.actions.act_window">
        <field name="name">Séances de Dialyse</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hms.treatment</field>
        <field name="view_mode">list,form,calendar,pivot</field>
        <field name="domain" eval="[('department_id.department_type','=','nephrology')]"/>
        <field name="context">{'acs_department_type': 'nephrology'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun enregistrement trouvé
            </p>
            <p>
                Cliquez pour ajouter une séance de dialyse.
            </p>
        </field>
    </record>

    <record id="action_acs_nephrology_procedure" model="ir.actions.act_window">
        <field name="name">Hémodialyse du patient</field>
        <field name="res_model">acs.patient.procedure</field>
        <field name="view_mode">list,form,calendar,pivot</field>
        <field name="context">{'acs_department_type': 'nephrology', 'search_default_not_done': 1}</field>
        <field name="domain" eval="[('department_id.department_type','=','nephrology')]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Cliquez pour ajouter une hémodialyse du patient.
            </p>
        </field>
    </record>

    <!--Dental Procedures-->
    <record id="action_nephrology_procedure" model="ir.actions.act_window">
        <field name="name">Hémodialyses</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="product.product_template_kanban_view"/>
        <field name="domain">[('hospital_product_type','=','nephrology_procedure')]</field>
        <field name="context">{'default_hospital_product_type': 'nephrology_procedure', 'default_detailed_type': 'service'}</field>
    </record>

    <!-- Treatment View Inheritance -->
    <record id="view_hospital_hms_treatment_form_nephrology" model="ir.ui.view">
        <field name="name">hms.treatment.form.nephrology</field>
        <field name="model">hms.treatment</field>
        <field name="inherit_id" ref="acs_hms.view_hospital_hms_treatment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='patient_procedure_ids']/list/field[@name='physician_id']" position="after">
                <field name="nephrology_schedule_ids" widget="many2many_tags" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>