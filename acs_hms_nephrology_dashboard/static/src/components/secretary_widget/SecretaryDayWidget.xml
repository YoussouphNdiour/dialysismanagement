<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-name="acs_hms_nephrology_dashboard.SecretaryDayWidget">
    <div class="sw-container">

      <!-- En-tête -->
      <div class="sw-header">
        <h2 class="sw-title">
          <i class="fa fa-calendar-check-o sw-icon-title"/> Résumé du jour
        </h2>
        <div class="sw-header-right">
          <span t-if="state.lastRefresh" class="sw-refresh-time">
            Mis à jour à <t t-esc="state.lastRefresh"/>
          </span>
          <button class="btn btn-sm btn-outline-secondary sw-btn-refresh"
                  t-on-click="onRefresh"
                  t-att-disabled="state.loading">
            <i class="fa fa-refresh" t-att-class="state.loading ? 'fa-spin' : ''"/>
            Actualiser
          </button>
        </div>
      </div>

      <!-- Chargement -->
      <div t-if="state.loading and not state.data" class="sw-loading">
        <i class="fa fa-spinner fa-spin fa-2x"/>
        <p>Chargement en cours…</p>
      </div>

      <!-- Erreur -->
      <div t-elif="state.error" class="alert alert-danger">
        <i class="fa fa-exclamation-triangle"/> <t t-esc="state.error"/>
      </div>

      <!-- Données -->
      <t t-elif="state.data">
        <div class="sw-grid">

          <!-- Bloc Patients matin -->
          <div class="sw-card sw-card-morning">
            <div class="sw-card-icon"><i class="fa fa-sun-o"/></div>
            <div class="sw-card-body">
              <div class="sw-card-value" t-esc="state.data.patients_morning"/>
              <div class="sw-card-label">Patients matin</div>
              <div class="sw-card-sub">avant 12h00</div>
            </div>
          </div>

          <!-- Bloc Patients après-midi -->
          <div class="sw-card sw-card-afternoon">
            <div class="sw-card-icon"><i class="fa fa-moon-o"/></div>
            <div class="sw-card-body">
              <div class="sw-card-value" t-esc="state.data.patients_afternoon"/>
              <div class="sw-card-label">Patients après-midi</div>
              <div class="sw-card-sub">à partir de 12h00</div>
            </div>
          </div>

          <!-- Bloc Postes occupés -->
          <div class="sw-card sw-card-stations">
            <div class="sw-card-icon"><i class="fa fa-hospital-o"/></div>
            <div class="sw-card-body">
              <div class="sw-card-value">
                <t t-esc="state.data.stations_occupied"/>
                <span class="sw-card-total">/<t t-esc="state.data.total_stations"/></span>
              </div>
              <div class="sw-card-label">Postes occupés</div>
              <div class="sw-progress">
                <div class="sw-progress-bar"
                     t-att-style="'width:' + occupancyPercent + '%'"/>
              </div>
              <div class="sw-card-sub"><t t-esc="occupancyPercent"/>% de capacité</div>
            </div>
          </div>

          <!-- Bloc Total séances -->
          <div class="sw-card sw-card-total">
            <div class="sw-card-icon"><i class="fa fa-list-alt"/></div>
            <div class="sw-card-body">
              <div class="sw-card-value" t-esc="state.data.total_sessions"/>
              <div class="sw-card-label">Séances du jour</div>
              <div class="sw-card-sub">planifiées</div>
            </div>
          </div>

        </div>

        <!-- Répartition par statut -->
        <div class="sw-section-title">Répartition par statut</div>
        <div class="sw-status-grid">

          <div class="sw-status-item sw-status-confirmed">
            <span class="sw-status-count" t-esc="state.data.confirmed"/>
            <span class="sw-status-label">
              <i class="fa fa-check-circle"/> Confirmées
            </span>
          </div>

          <div class="sw-status-item sw-status-running">
            <span class="sw-status-count" t-esc="state.data.running"/>
            <span class="sw-status-label">
              <i class="fa fa-play-circle"/> En cours
            </span>
          </div>

          <div class="sw-status-item sw-status-done">
            <span class="sw-status-count" t-esc="state.data.done"/>
            <span class="sw-status-label">
              <i class="fa fa-flag-checkered"/> Terminées
            </span>
          </div>

          <div class="sw-status-item sw-status-absent">
            <span class="sw-status-count" t-esc="state.data.absent"/>
            <span class="sw-status-label">
              <i class="fa fa-user-times"/> Absentes
            </span>
          </div>

          <div class="sw-status-item sw-status-rescheduled">
            <span class="sw-status-count" t-esc="state.data.rescheduled"/>
            <span class="sw-status-label">
              <i class="fa fa-calendar-o"/> Reportées
            </span>
          </div>

          <div class="sw-status-item sw-status-pending">
            <span class="sw-status-count" t-esc="state.data.pending"/>
            <span class="sw-status-label">
              <i class="fa fa-clock-o"/> Non confirmées
            </span>
          </div>

        </div>

        <!-- Alertes capacité -->
        <t t-if="state.data.overloaded_stations and state.data.overloaded_stations.length">
          <div class="alert alert-warning sw-alert-capacity">
            <i class="fa fa-exclamation-triangle"/>
            <strong>Postes en surcharge :</strong>
            <t t-foreach="state.data.overloaded_stations" t-as="s" t-key="s.id">
              <span class="badge text-bg-warning ms-1"><t t-esc="s.name"/></span>
            </t>
          </div>
        </t>

      </t>

    </div>
  </t>

</templates>
