<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_nephro_billing" model="ir.ui.view">
        <field name="name">res.config.settings.nephro.billing</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[last()]" position="after">
                <app string="Facturation Dialyse" name="acs_hms_nephrology_billing" groups="acs_hms_nephrology_billing.group_nephrology_billing">
                    <setting string="Facturation automatique" help="Crée automatiquement une facture brouillon à la fin de chaque séance.">
                        <field name="nephro_auto_invoice"/>
                    </setting>
                    <setting string="Délai impayé (jours)" help="Nombre de jours avant qu'une facture soit considérée comme impayée.">
                        <field name="nephro_overdue_days"/>
                    </setting>
                    <setting string="Alerte email impayé">
                        <field name="nephro_alert_email"/>
                    </setting>
                    <setting string="Alerte WhatsApp impayé">
                        <field name="nephro_alert_whatsapp"/>
                    </setting>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
