<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Surgical History Views -->
    <record id="view_acs_surgical_history_list" model="ir.ui.view">
        <field name="name">acs.surgical.history.list</field>
        <field name="model">acs.surgical.history</field>
        <field name="arch" type="xml">
            <list string="Surgical History">
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_acs_surgical_history_form" model="ir.ui.view">
        <field name="name">acs.surgical.history.form</field>
        <field name="model">acs.surgical.history</field>
        <field name="arch" type="xml">
            <form string="Surgical History">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_acs_surgical_history" model="ir.actions.act_window">
        <field name="name">Surgical History</field>
        <field name="res_model">acs.surgical.history</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Surgical History found. Let's create one!
            </p>
            <p>
                Define surgical procedures (e.g., Fracture, APP, Hernie, Césarienne).
            </p>
        </field>
    </record>

