<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ============================================================
         HMS → renommé "Clinique"
    ============================================================ -->
    <menuitem id="menu_hms" name="Clinique" sequence="30"
        groups="acs_hms_base.group_hms_manager"
        web_icon="acs_hms_base,static/description/icon.png"/>

    <menuitem id="action_menu_patient" name="Patients" sequence="0"
        parent="menu_hms" action="acs_hms_base.action_patient"/>

    <menuitem id="action_menu_doctors" name="Physicians" parent="menu_hms"
        action="acs_hms_base.action_physician" sequence="2"/>

    <menuitem id="action_menu_treatment" name="Treatments" parent="menu_hms"
        sequence="3" action="acs_action_form_hospital_treatment"/>

    <menuitem id="menu_acs_patient_procedure" name="Patient Procedures"
        parent="menu_hms" action="action_acs_patient_procedure" sequence="4"/>

    <menuitem id="menu_appointment" name="Appointment" sequence="5"
        parent="menu_hms" action="action_appointment"/>

    <menuitem id="hos_prescription" name="Prescription" parent="acs_hms.menu_hms"
        sequence="5" groups="acs_hms.group_hms_jr_doctor"
        action="act_open_hms_prescription_order_view"/>

    <menuitem id="menu_referring_doctors" sequence="15"
        parent="acs_hms.menu_hms" action='acs_hms_base.action_referring_doctors'/>

    <menuitem id="menu_product_pricelist_main" name="Pricelist"
        parent="acs_hms.menu_hms" action="product.product_pricelist_action2"
        groups="product.group_product_pricelist" sequence="20"/>

    <menuitem id="menu_hms_configuration" name="Configuration"
        parent="menu_hms" groups="acs_hms_base.group_hms_manager" sequence="100"/>

    <menuitem id="menu_hms_configuration_settings" name="Settings"
        parent="menu_hms_configuration" sequence="0"
        action="acs_hms_base.action_hms_config_settings"
        groups="base.group_system"/>

    <menuitem id="menu_working_schedule" sequence="20"
        parent="menu_hms_configuration" action='resource.action_resource_calendar_form'/>

    <!-- Patient Configuration -->
    <menuitem id="menu_medical_alerts" name="Medical Alerts" sequence="11"
        parent="acs_hms_base.menu_hms_patient_cofig"
        action="acs_hms.act_open_medical_alerts"/>
    <menuitem id="menu_allergy" name="Allergies" sequence="11"
        parent="acs_hms_base.menu_hms_patient_cofig"
        action="acs_hms.action_acs_medical_allergy"/>
