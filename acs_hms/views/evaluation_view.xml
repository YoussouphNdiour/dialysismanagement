<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_acs_patient_evaluation_form" model="ir.ui.view">
        <field name="name">Patient Evaluation</field>
        <field name="model">acs.patient.evaluation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_done" invisible="state != 'draft'" groups="acs_hms.group_hms_jr_doctor,acs_hms.group_hms_nurse" type="object" string="Done" class="oe_highlight"/>
                    <button name="action_cancel" string="Cancel" invisible="state != 'draft'" type="object"/>
                    <button name="action_draft" string="Draft" invisible="state != 'cancel'" type="object"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <field name="image_128" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" default_focus="1" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id" readonly="state in ['cancel','done']"/>
                            <field name="age" readonly="1"/>
                            <field name="appointment_id" domain="[('patient_id','=', patient_id)]" context="{'default_patient_id': patient_id, 'default_physician_id': physician_id}" readonly="state in ['cancel','done']"/>
                        </group>
                        <group>
                            <field name="physician_id" readonly="state in ['cancel','done']"/>
                            <field name="date" readonly="state in ['cancel','done']"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}" readonly="state in ['cancel','done']"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="details" string="Details" groups="acs_hms.group_hms_nurse">
                            <group>
                                <group>
                                    <label for="weight"/>
                                    <div class="o_row" name="div_weight">
                                        <field name="weight" readonly="state in ['cancel','done']"/>
                                        <field name="acs_weight_name"/>
                                    </div>
                                    <label for="height"/>
                                    <div class="o_row" name="div_height">
                                        <field name="height" readonly="state in ['cancel','done']"/>
                                        <field name="acs_height_name"/>
                                    </div>
                                    <label for="temp"/>
                                    <div class="o_row" name="div_temp">
                                        <field name="temp" readonly="state in ['cancel','done']"/>
                                        <field name="acs_temp_name"/>
                                    </div>
                                    <label for="hr"/>
                                    <div class="o_row" name="div_hr">
                                        <field name="hr" readonly="state in ['cancel','done']"/>
                                        <div>bpm</div>
                                    </div>
                                    <label for="rr"/>
                                    <div class="o_row" name="div_rr">
                                        <field name="rr" readonly="state in ['cancel','done']"/>
                                        <div>bpm</div>
                                    </div>
                                </group>
                                <group>
                                    <label string="Systolic/Diastolic BP" for="systolic_bp"/>
                                    <div class="o_row" name="div_systolic_bp">
                                        <div class="oe_inline" style="display: inline;" >
                                            <field name="systolic_bp" class="oe_inline" readonly="state in ['cancel','done']"/>/<field name="diastolic_bp" class="oe_inline" readonly="state in ['cancel','done']"/>
                                        </div>
                                    </div>
                                    <label for="spo2"/>
                                    <div class="o_row" name="div_spo2">
                                        <field name="spo2" readonly="state in ['cancel','done']"/>
                                        <field name="acs_spo2_name"/>
                                    </div>
                                    <label for="rbs"/>
                                    <div class="o_row" name="div_rbs">
                                        <field name="rbs" readonly="state in ['cancel','done']"/>
                                        <field name="acs_rbs_name"/>
                                    </div>
                                    <!-- Head Circumference hidden as requested -->
                                    <!-- <label for="head_circum"/>
                                    <div class="o_row" name="div_head_circum">
                                        <field name="head_circum" readonly="state in ['cancel','done']"/>
                                        <field name="acs_head_circum_name"/>
                                    </div> -->
                                </group>
                                <group>
                                    <field name="bmi"/>
                                </group>
                                <group>
                                    <field name="bmi_state"/>
                                </group>
                            </group>

                            <separator string="Pain Level"/>
                            <group>
                                <group>
                                    <label for="pain_level"/>
                                    <div class="o_row" name="div_pain_level">
                                        <field name="pain_level" readonly="state in ['cancel','done']"/>
                                        <span><button name="%(action_acs_pain_level)d" type="action" icon="fa-question-circle"  title="Pain Level"/></span>
                                    </div>
                                </group>
                                <field name="pain" nolabel="1" readonly="state in ['cancel','done']"/>
                            </group>

                            <separator string="Examens Physiques Détaillés"/>
                            <group>
                                <group>
                                    <field name="tete" placeholder="Tête..." readonly="state in ['cancel','done']"/>
                                    <field name="cou" placeholder="Cou..." readonly="state in ['cancel','done']"/>
                                    <field name="thorax" placeholder="Thorax..." readonly="state in ['cancel','done']"/>
                                    <field name="abdomen" placeholder="Abdomen..." readonly="state in ['cancel','done']"/>
                                </group>
                                <group>
                                    <field name="msmi" placeholder="MSMI..." readonly="state in ['cancel','done']"/>
                                    <field name="oge" placeholder="OGE..." readonly="state in ['cancel','done']"/>
                                    <field name="traitement" placeholder="Traitement..." readonly="state in ['cancel','done']"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="view_acs_patient_evaluation_search">
        <field name="name">evaluation.list</field>
        <field name="model">acs.patient.evaluation</field>
        <field name="arch" type="xml">
            <search string="Patient Evaluation">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="date"/>
                <group name="group_by">
                     <filter string="Patient" name="patient_groupby" domain="[]" context="{'group_by':'patient_id'}"/>
                    <filter string="Date" name="date_groupby" domain="[]" context="{'group_by':'date'}" />
                    <filter string="State" name="state_groupby" domain="[]" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="view_acs_patient_evaluation_list">
        <field name="name">treatment.list</field>
        <field name="model">acs.patient.evaluation</field>
        <field name="arch" type="xml">
            <list string="Patient Evaluation">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="date"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>


    <record id="view_acs_patient_evaluation_calendar" model="ir.ui.view">
        <field name="name">acs.patient.evaluation.calendar</field>
        <field name="model">acs.patient.evaluation</field>
        <field name="type">calendar</field>
        <field name="arch" type="xml">
            <calendar string="Patient Evaluations" color="patient_id" date_start="date">
                <field name="physician_id"/>
                <field name="patient_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="view_acs_patient_evaluation_pivot" model="ir.ui.view">
        <field name="name">acs.patient.evaluation.pivot</field>
        <field name="model">acs.patient.evaluation</field>
        <field name="arch" type="xml">
            <pivot string="Patient Evaluations">
                <field name="date" type="row"/>
                <field name="physician_id" type="row"/>
            </pivot>
        </field>
    </record>

    <record id="action_acs_patient_evaluation" model="ir.actions.act_window">
        <field name="name">Patient Evaluation</field>
        <field name="path">almightyhms-patient-evaluation</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">acs.patient.evaluation</field>
        <field name="view_mode">list,form,calendar,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Record Found
            </p>
            <p>
                Click to add a Patient Evaluation.
            </p>
        </field>
    </record>

    <!-- POPUP -->
    <record id="view_acs_patient_evaluation_popup_form" model="ir.ui.view">
        <field name="name">acs.patient.evaluation.form</field>
        <field name="model">acs.patient.evaluation</field>
        <field name="inherit_id" ref="acs_hms.view_acs_patient_evaluation_form"/>
        <field name="mode">primary</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <sheet position="after">
                <footer>
                    <button name="create_evaluation" type="object" string="Create" class="oe_highlight"/>
                    <button string="Cancel" class="oe_link" special="cancel" />
                </footer>
            </sheet>
        </field>
    </record>

    <record id="action_acs_patient_evaluation_popup" model="ir.actions.act_window">
        <field name="name">Evaluation</field>
        <field name="path">almightyhms-evaluation</field>
        <field name="res_model">acs.patient.evaluation</field>
        <field name="view_id" ref="view_acs_patient_evaluation_popup_form"/>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>