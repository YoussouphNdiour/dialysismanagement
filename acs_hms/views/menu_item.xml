        action="action_appointment_invoice_exempt_request"
        groups="acs_hms_base.group_acs_invoice_exemption"/>
    <menuitem id="menu_appointment_cofig" name="Configuration"
        parent="acs_hms.main_menu_appointment" sequence="100"/>
    <menuitem id="menu_patient_appointment" name="Appointment Purpose"
        sequence="0" parent="acs_hms.menu_appointment_cofig"
        action="act_open_appointment_purpose"
        groups="acs_hms_base.group_hms_manager"/>
    <menuitem id="menu_open_appointment_cabin" name="Appointment Cabin"
        sequence="1" parent="acs_hms.menu_appointment_cofig"
        action="act_open_appointment_cabin"
        groups="acs_hms_base.group_hms_manager"/>
    <menuitem id="menu_acs_cancel_reason" name="Cancel Reason" sequence="50"
        parent="menu_appointment_cofig"
        action="action_acs_cancel_reason"
        groups="acs_hms_base.group_hms_manager"/>

    <menuitem id="main_menu_prescription" name="Prescription" sequence="25"
        groups="acs_hms.group_hms_jr_doctor"
        web_icon="acs_hms,static/src/img/prescription.png"/>
    <menuitem id="menu_prescription" name="Prescription"
        parent="main_menu_prescription"
        action="act_open_hms_prescription_order_view"/>
    <menuitem id="menu_prescription_configuration" name="Configuration"
        parent="main_menu_prescription"
        groups="acs_hms.group_hms_doctor" sequence="100"/>
    <menuitem id="menu_medicament_group" name="Medicament Group"
        parent="menu_prescription_configuration"
        action="act_open_medicament_group_view" sequence="11"/>

    <!-- Médicaments -->
    <menuitem id="menu_medicine_medicament_dosage" name="Medication Dosage"
        parent="acs_hms_base.menu_medicine_cofig"
        action="action_medicament_dosage" sequence="7"/>
    <menuitem id="menu_medicine_hms_medicament_group" name="Medicament Group"
        parent="acs_hms_base.acs_medicine_root"
        action="act_open_medicament_group_view" sequence="11"/>
    <menuitem id="menu_acs_product_kit" name="Product Kit"
        parent="acs_hms_base.acs_medicine_root"
        action="action_acs_product_kit" sequence="15"/>

    <!-- ============================================================
         DÉSACTIVATION des menus standalone via <record>
         (seule méthode fiable en Odoo)
    ============================================================ -->
    <record id="action_menu_working_schedule" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="main_menu_treatment" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="main_menu_appointment" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="main_menu_prescription" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <record id="acs_hms_evaluation_graph" model="ir.actions.client">
        <field name="name">Evaluation Charts</field>
        <field name="tag">AlmightyHmsEvaluation</field>
    </record>
</odoo>
