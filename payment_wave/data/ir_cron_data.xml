<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron job to process Wave margin payouts -->
        <record id="ir_cron_wave_margin_payouts" model="ir.cron">
            <field name="name">Wave: Process Margin Payouts</field>
            <field name="model_id" ref="payment.model_payment_transaction"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_wave_margin_payouts()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron job to cleanup old Wave data (runs monthly) -->
        <record id="ir_cron_wave_cleanup" model="ir.cron">
            <field name="name">Wave: Cleanup Old Data</field>
            <field name="model_id" ref="payment.model_payment_transaction"/>
            <field name="state">code</field>
            <field name="code">model._cron_cleanup_old_wave_data()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
