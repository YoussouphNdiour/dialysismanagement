        action="acs_hms.action_acs_family_relation"
        parent="acs_hms_base.menu_hms_patient_cofig" sequence="12"/>
    <menuitem id="menu_surgical_history" name="Surgical History" sequence="12"
        parent="acs_hms_base.menu_hms_patient_cofig"
        action="acs_hms.action_acs_surgical_history"/>
    <menuitem id="menu_fav_location" name="FAV Location" sequence="12"
        parent="acs_hms_base.menu_hms_patient_cofig"
        action="acs_hms.action_acs_fav_location"/>
    <menuitem id="menu_lifestyle" name="Lifestyle" sequence="13"
        parent="acs_hms_base.menu_hms_patient_cofig"
        action="acs_hms.action_acs_lifestyle"/>
    <menuitem id="menu_family_relation_type" name="Family Relation Types"
        sequence="14" parent="acs_hms_base.menu_hms_patient_cofig"
        action="acs_hms.action_acs_family_relation_type"/>
    <menuitem id="menu_ethnicity" name="Ethnicity" sequence="25"
        parent="acs_hms_base.menu_hms_patient_cofig"
        action="acs_hms.act_open_acs_ethnicity_view"/>

    <menuitem id="diseases_menu" name="Diseases"
        parent="acs_hms_base.menu_hms_patient_cofig" sequence="100"/>
    <menuitem id="hms_diseases" name="Diseases"
        action="acs_hms.act_open_diseases_view"
        parent="acs_hms.diseases_menu" sequence="0"/>
    <menuitem id="menu_disease_category" name="Disease Categories" sequence="10"
        parent="acs_hms.diseases_menu"
        action="acs_hms.act_open_acs_disease_category_view"/>
    <menuitem id="menu_hms_genetic_disease" name="Genetic Disease" sequence="20"
        parent="acs_hms.diseases_menu"
        action="acs_hms.action_hms_genetic_disease"/>

    <!-- ============================================================
         MENUS STANDALONE — définis pour leurs sous-menus,
         désactivés via <record> ci-dessous
    ============================================================ -->
    <menuitem id="action_menu_working_schedule" name="Schedule" sequence="75"
        groups="acs_hms.group_hms_receptionist,acs_hms.group_hms_jr_doctor"
        action="action_resource_calendar"
        web_icon="acs_hms,static/src/img/calendar.png"/>

    <menuitem id="main_menu_treatment" name="Treatments" sequence="25"
        groups="acs_hms.group_hms_receptionist,acs_hms.group_hms_jr_doctor"
        web_icon="acs_hms,static/src/img/treatment.png"/>
    <menuitem id="menu_treatment" name="Treatments"
        parent="main_menu_treatment"
        action="acs_action_form_hospital_treatment" sequence="10"/>
    <menuitem id="menu_acs_patient_procedure_treatment" name="Patient Procedures"
        parent="main_menu_treatment"
        action="action_acs_patient_procedure" sequence="20"/>
    <menuitem id="menu_treatment_cofig" name="Configuration"
        parent="main_menu_treatment"
        groups="acs_hms_base.group_hms_manager" sequence="100"/>
    <menuitem id="menu_procedure_group" name="Procedure Groups"
        parent="menu_treatment_cofig"
        action="action_procedure_group" sequence="10"/>

