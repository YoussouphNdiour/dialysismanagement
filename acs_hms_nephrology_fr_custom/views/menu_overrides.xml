<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
    ════════════════════════════════════════════════════════════════
    TRADUCTION / FRANCISATION DES MENUS ACS HMS
    Module : acs_hms_nephrology_fr_custom
    ────────────────────────────────────────────────────────────────
    Ce fichier renomme directement les enregistrements ir.ui.menu
    (champ name) pour tous les menus qui restent en anglais dans les
    modules acs_hms_base et acs_hms.

    Organisation par type d'utilisateur :
    ─ Patients     → group_hms_user     (tous les utilisateurs cliniques)
    ─ Médecins     → group_hms_user     (consultation des médecins)
    ─ Médicaments  → group_manage_medicines
    ─ Services     → group_manage_services
    ─ Clinique     → group_hms_manager  (accès admin complet)
    ─ Néphrologie  → group_hms_nephrology_user (flux principal)
    ─ Facturation  → group_nephrology_billing
    ════════════════════════════════════════════════════════════════
    -->

    <!-- ============================================================
         APPLICATION "PATIENTS" (acs_hms_base.main_menu_patient)
         Visible : tous les utilisateurs HMS
    ============================================================ -->
    <record id="acs_hms_base.main_menu_patient" model="ir.ui.menu">
        <field name="name">Patients</field>
    </record>
    <record id="acs_hms_base.action_main_menu_patient" model="ir.ui.menu">
        <field name="name">Patients</field>
    </record>

