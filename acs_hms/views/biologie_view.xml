<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_acs_patient_biologie_form" model="ir.ui.view">
        <field name="name">Patient Biologie</field>
        <field name="model">acs.patient.biologie</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_done" invisible="state != 'draft'" groups="acs_hms.group_hms_jr_doctor,acs_hms.group_hms_medical_officer" type="object" string="Done" class="oe_highlight"/>
                    <button name="action_cancel" string="Cancel" invisible="state != 'draft'" type="object"/>
                    <button name="action_draft" string="Draft" invisible="state != 'cancel'" type="object"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <field name="image_128" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" default_focus="1" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id" readonly="state in ['cancel','done']"/>
                            <field name="age" readonly="1"/>
                        </group>
                        <group>
                            <field name="physician_id" readonly="state in ['cancel','done']"/>
                            <field name="date" readonly="state in ['cancel','done']"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}" readonly="state in ['cancel','done']"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="hematology" string="Hématologie" groups="acs_hms.group_hms_jr_doctor">
                            <group>
                                <group>
                                    <field name="gb" readonly="state in ['cancel','done']"/>
                                    <field name="hb" readonly="state in ['cancel','done']"/>
                                    <field name="vgm" readonly="state in ['cancel','done']"/>
                                    <field name="ccmh" readonly="state in ['cancel','done']"/>
                                </group>
                                <group>
                                    <field name="plt" readonly="state in ['cancel','done']"/>
                                    <field name="leu" readonly="state in ['cancel','done']"/>
                                    <field name="crp" readonly="state in ['cancel','done']"/>
                                    <field name="uricemie" readonly="state in ['cancel','done']"/>
                                    <field name="gaj" readonly="state in ['cancel','done']"/>
                                    <field name="hba1c" readonly="state in ['cancel','done']"/>
                                </group>
                            </group>
                            <group string="Bilan Martial">
                                <group>
                                    <field name="cst" readonly="state in ['cancel','done']"/>
                                </group>
                                <group>
                                    <field name="serum_iron" readonly="state in ['cancel','done']"/>
                                </group>
                            </group>
                        </page>
                        <page name="kidney_function" string="Fonction Rénale" groups="acs_hms.group_hms_jr_doctor">
                            <group>
                                <group>
                                    <field name="uree" readonly="state in ['cancel','done']"/>
                                    <field name="creat" readonly="state in ['cancel','done']"/>
                                </group>
                                <group>
                                    <field name="dfg_mdrd" readonly="state in ['cancel','done']"/>
                                </group>
                            </group>
                        </page>
                        <page name="electrolytes" string="Électrolytes" groups="acs_hms.group_hms_jr_doctor">
                            <group>
                                <group>
                                    <field name="sodium" readonly="state in ['cancel','done']"/>
                                    <field name="potassium" readonly="state in ['cancel','done']"/>
                                </group>
                                <group>
                                    <field name="chlore" readonly="state in ['cancel','done']"/>
                                    <field name="reserve_alcaline" readonly="state in ['cancel','done']"/>
                                </group>
                            </group>
                        </page>
                        <page name="lipid_profile" string="Bilan Lipidique" groups="acs_hms.group_hms_jr_doctor">
                            <group>
                                <group>
                                    <field name="hdl" readonly="state in ['cancel','done']"/>
                                    <field name="ldl" readonly="state in ['cancel','done']"/>
                                    <field name="ct" readonly="state in ['cancel','done']"/>
                                    <field name="tg" readonly="state in ['cancel','done']"/>
                                </group>
                                <group>
                                    <field name="albuminemie" readonly="state in ['cancel','done']"/>
                                    <field name="proteidemie" readonly="state in ['cancel','done']"/>
                                    <field name="pal" readonly="state in ['cancel','done']"/>
                                    <field name="bilirubine_t" readonly="state in ['cancel','done']"/>
                                    <field name="bilirubine_i" readonly="state in ['cancel','done']"/>
                                    <field name="epps" readonly="state in ['cancel','done']"/>
                                </group>
                            </group>
                        </page>
                        <page name="liver_function" string="Bilan Hépatique" groups="acs_hms.group_hms_jr_doctor">
                            <group string="Transaminases">
                                <group>
                                    <field name="alat" readonly="state in ['cancel','done']"/>
                                    <field name="asat" readonly="state in ['cancel','done']"/>
                                    <field name="gamma_gt" readonly="state in ['cancel','done']"/>
                                    <field name="ldh" readonly="state in ['cancel','done']"/>
                                </group>
                                <group>
                                    <field name="cpk" readonly="state in ['cancel','done']"/>
                                    <field name="haptoglobine" readonly="state in ['cancel','done']"/>
                                    <field name="schizocytes" readonly="state in ['cancel','done']"/>
                                    <field name="rac" readonly="state in ['cancel','done']"/>
                                </group>
                            </group>
                            <separator string="Sérologie Hépatite B"/>
                            <group>
                                <group>
                                    <field name="serologie_aghbs" readonly="state in ['cancel','done']"/>
                                    <field name="serologie_ac_anti_hbs" readonly="state in ['cancel','done']"/>
                                    <field name="serologie_ac_anti_hbc" readonly="state in ['cancel','done']"/>
                                </group>
                                <group>
                                    <field name="serologie_interpretation" readonly="1"
                                           class="alert alert-info"
                                           role="status"
                                           invisible="not serologie_interpretation"
                                           widget="text"/>
                                </group>
                            </group>
                        </page>
                        <page name="minerals_vitamins" string="Minéraux et Vitamines" groups="acs_hms.group_hms_jr_doctor">
                            <group>
                                <group>
                                    <field name="calcium" readonly="state in ['cancel','done']"/>
                                    <field name="phosphore" readonly="state in ['cancel','done']"/>
                                </group>
                                <group>
                                    <field name="pthi" readonly="state in ['cancel','done']"/>
                                    <field name="vitamine_d" readonly="state in ['cancel','done']"/>
                                </group>
                            </group>
                        </page>
                        <page name="bilan_martial" string="Bilan Martial" groups="acs_hms.group_hms_jr_doctor">
                            <group>
                                <group>
                                    <field name="ferritinemia" readonly="state in ['cancel','done']"/>
                                    <field name="cst" readonly="state in ['cancel','done']"/>
                                </group>
                                <group>
                                    <field name="serum_iron" readonly="state in ['cancel','done']"/>
                                </group>
                            </group>
                        </page>
                        <page name="urine" string="Urine" groups="acs_hms.group_hms_jr_doctor">
                            <group>
                                <group>
                                    <field name="pu_24h" readonly="state in ['cancel','done']"/>
                                    <field name="eppu" readonly="state in ['cancel','done']"/>
                                    <field name="ecbu" readonly="state in ['cancel','done']"/>
                                    <field name="nau" readonly="state in ['cancel','done']"/>
                                </group>
                                <group>
                                    <field name="ku" readonly="state in ['cancel','done']"/>
                                    <field name="rapport_na_k" readonly="state in ['cancel','done']"/>
                                    <field name="uree_urinaire" readonly="state in ['cancel','done']"/>
                                    <field name="creat_urinaire" readonly="state in ['cancel','done']"/>
                                </group>
                            </group>
                        </page>
                        <page name="pbr" string="PBR" groups="acs_hms.group_hms_jr_doctor">
                            <group>
                                <field name="pbr_resultat" nolabel="1" readonly="state in ['cancel','done']" placeholder="Résultat de la PBR..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="view_acs_patient_biologie_search">
        <field name="name">biologie.search</field>
        <field name="model">acs.patient.biologie</field>
        <field name="arch" type="xml">
            <search string="Patient Biologie">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="date"/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Done" name="done" domain="[('state','=','done')]"/>
                <group name="group_by">
                    <filter string="Patient" name="patient_groupby" domain="[]" context="{'group_by':'patient_id'}"/>
                    <filter string="Date" name="date_groupby" domain="[]" context="{'group_by':'date'}"/>
                    <filter string="State" name="state_groupby" domain="[]" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="view_acs_patient_biologie_list">
        <field name="name">biologie.list</field>
        <field name="model">acs.patient.biologie</field>
        <field name="arch" type="xml">
            <list string="Patient Biologie">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="physician_id"/>
                <field name="date"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_acs_patient_biologie_calendar" model="ir.ui.view">
        <field name="name">acs.patient.biologie.calendar</field>
        <field name="model">acs.patient.biologie</field>
        <field name="type">calendar</field>
        <field name="arch" type="xml">
            <calendar string="Biologie" date_start="date" color="patient_id" quick_create="0">
                <field name="patient_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="action_acs_patient_biologie" model="ir.actions.act_window">
        <field name="name">Biologie</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">acs.patient.biologie</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="context">{'search_default_done': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Record Found
            </p>
            <p>
                Click to add a Patient Biologie Record.
            </p>
        </field>
    </record>

</odoo>
