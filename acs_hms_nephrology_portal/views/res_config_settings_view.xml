<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_nephro_portal" model="ir.ui.view">
        <field name="name">res.config.settings.nephro.portal</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[last()]" position="after">
                <app string="Portail Patient" name="acs_hms_nephrology_portal">
                    <setting string="Langage simplifié" help="Affiche 'Séance efficace / insuffisante' au lieu de la valeur KT/V brute">
                        <field name="portal_simplified_language"/>
                    </setting>
                    <setting string="Afficher valeurs brutes" help="Montre aussi le chiffre KT/V en plus du texte simplifié"
                             invisible="not portal_simplified_language">
                        <field name="portal_show_raw_values"/>
                    </setting>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
