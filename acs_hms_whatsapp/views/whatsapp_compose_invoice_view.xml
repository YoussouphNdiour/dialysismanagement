<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- WhatsApp Invoice Composer Form View -->
    <record id="view_whatsapp_compose_invoice_form" model="ir.ui.view">
        <field name="name">whatsapp.compose.invoice.form</field>
        <field name="model">whatsapp.compose.invoice</field>
        <field name="arch" type="xml">
            <form string="Send Invoice via WhatsApp">
                <sheet>
                    <group>
                        <group>
                            <field name="invoice_id" readonly="1"/>
                            <field name="patient_id" readonly="1"/>
                            <field name="phone" placeholder="+221771234567"/>
                        </group>
                        <group>
                            <field name="send_as"/>
                        </group>
                    </group>
                    <group>
                        <field name="message_text" placeholder="Enter your message here..."/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <strong>Info:</strong> La facture sera envoyée au patient et à tous ses contacts d'urgence.
                    </div>
                </sheet>
                <footer>
                    <button string="Send" name="action_send_and_close" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open WhatsApp Invoice Composer -->
    <record id="action_whatsapp_compose_invoice" model="ir.actions.act_window">
        <field name="name">Send Invoice via WhatsApp</field>
        <field name="res_model">whatsapp.compose.invoice</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">form</field>
    </record>

</odoo>
